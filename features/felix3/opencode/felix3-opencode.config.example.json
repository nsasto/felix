{
  "schema_version": 1,
  "work_source": {
    "provider": "manual-spec",
    "specs_dir": "specs",
    "ready_status": "ready-for-agent",
    "cloud": { "agent_id": "" }
  },
  "artifacts": {
    "runs_dir": ".felix3/runs",
    "local_retention_days": 30
  },
  "cloud_sync": {
    "enabled": false,
    "base_url": "https://api.runfelix.io",
    "api_key": "",
    "agent_key": "",
    "include_phase_summaries": true,
    "include_question_text": false,
    "artifacts": []
  },
  "harness": {
    "provider": "opencode",
    "opencode": {
      "executable": "opencode",
      "model": "opencode-go/deepseek-v4-pro",
      "agent": "felix3-build",
      "auto_approve": true,
      "session_policy": "fresh",
      "phases": {
        "planning": {
          "model": "opencode-go/deepseek-v4-pro",
          "agent": "felix3-plan",
          "auto_approve": false,
          "session_policy": "fresh"
        },
        "building": {
          "model": "opencode-go/deepseek-v4-pro",
          "agent": "felix3-build",
          "auto_approve": true,
          "session_policy": "resume"
        },
        "reviewing": {
          "model": "opencode-go/deepseek-v4-pro",
          "agent": "felix3-review",
          "auto_approve": false,
          "session_policy": "fresh"
        }
      }
    }
  },
  "workflow": {
    "require_plan_approval": false,
    "max_build_attempts": 3,
    "max_review_cycles": 2,
    "validation": {
      "require_at_least_one_command": true,
      "commands": []
    }
  }
}
