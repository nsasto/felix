{
  "schema_version": 1,
  "work_source": {
    "provider": "manual-spec",
    "specs_dir": "specs",
    "ready_status": "ready-for-agent"
  },
  "artifacts": {
    "runs_dir": ".felix3/runs",
    "local_retention_days": 30
  },
  "cloud_sync": {
    "enabled": false,
    "base_url": "https://runfelix.io",
    "agent_key": "",
    "include_phase_summaries": true,
    "include_question_text": false,
    "artifacts": []
  },
  "harness": {
    "provider": "claude-code",
    "claude-code": {
      "executable": "claude",
      "model": "sonnet",
      "permission_mode": "default",
      "max_turns": 100,
      "session_policy": "fresh",
      "phases": {
        "planning": {
          "model": "sonnet",
          "permission_mode": "plan",
          "max_turns": 60,
          "session_policy": "fresh"
        },
        "building": {
          "model": "sonnet",
          "permission_mode": "acceptEdits",
          "max_turns": 100,
          "session_policy": "resume"
        },
        "reviewing": {
          "model": "sonnet",
          "permission_mode": "plan",
          "max_turns": 60,
          "session_policy": "fresh"
        }
      }
    }
  },
  "workflow": {
    "require_plan_approval": false,
    "max_build_attempts": 3,
    "max_review_cycles": 2,
    "validation": {
      "require_at_least_one_command": true,
      "commands": []
    }
  }
}
